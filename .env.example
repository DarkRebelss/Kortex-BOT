# ========================================================
# Kyron - Çok Amaçlı Yönetim, Müzik & Topluluk Botu (.env)
# ========================================================

# Bot Belirteci (Geliştirici Portalından alınan belirteç)
# Format: <UygulamaKimliği>.<GizliAnahtar>
BOT_TOKEN=your_bot_token_here

# Micup API Base URL
MICUP_API_URL=https://micup.gg/api/v1

# Gateway WebSocket URL
MICUP_GATEWAY_URL=wss://micup.gg/gateway

# SQLite Veritabanı Dosya Yolu
DATABASE_PATH=./data/micup_bot.db

# Komut Ön Eki (Varsayılan: /)
COMMAND_PREFIX=/

# Bot Dili (tr veya en)
DEFAULT_LANGUAGE=tr

# Spotify Web API Token (İsteğe bağlı)
SPOTIFY_TOKEN=

# Özel FFmpeg Yolu (İsteğe bağlı - Pterodactyl/Linux sunucuda otomatik bulunamazsa: /usr/bin/ffmpeg)
FFMPEG_PATH=

# YouTube Çerezleri (İsteğe bağlı - Veri merkezlerinde yaş kısıtlı parçalar için cookies.txt içeriği)
YOUTUBE_COOKIE=
